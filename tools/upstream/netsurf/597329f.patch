From 597329fb856bca318a50d2c58f934356328a49cc Mon Sep 17 00:00:00 2001
From: Olivier Brunel <jjk@jjacky.com>
Date: Sat, 30 May 2026 14:54:45 +0000
Subject: [PATCH] nsurl: Treat 443 as a default port for HTTPS

Much like port 80 w/ HTTP, default port need not to be included
in the URL.

Signed-off-by: Olivier Brunel <jjk@jjacky.com>
---
 utils/nsurl/parse.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/utils/nsurl/parse.c b/utils/nsurl/parse.c
index ecf210b..b209c19 100644
--- a/utils/nsurl/parse.c
+++ b/utils/nsurl/parse.c
@@ -895,6 +895,17 @@ static nserror nsurl__create_from_section(const char * const url_s,
 					/* Scheme is http, and port is default
 					 * (80) */
 					flags |= NSURL_F_NO_PORT;
+				} else if (url->scheme != NULL &&
+						url->scheme_type ==
+						NSURL_SCHEME_HTTPS &&
+						length -
+						(colon - pegs->at + skip) == 3 &&
+						*sec_start == '4' &&
+						*(sec_start + 1) == '4' &&
+						*(sec_start + 2) == '3') {
+					/* Scheme is https, and port is default
+					 * (443) */
+					flags |= NSURL_F_NO_PORT;
 				}
 
 				if (length <= (colon - pegs->at + skip)) {
-- 
2.43.0

