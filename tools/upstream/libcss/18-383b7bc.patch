From 383b7bce38c013c7dd21bd4e152c095a0da157ef Mon Sep 17 00:00:00 2001
From: Michael Drake <tlsa@netsurf-browser.org>
Date: Fri, 6 Nov 2026 21:10:46 +0000
Subject: [PATCH] parse: calc: Fix handling of whitespace after divisor

---
 src/parse/properties/utils.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/parse/properties/utils.c b/src/parse/properties/utils.c
index 1528ed3..d377a40 100644
--- a/src/parse/properties/utils.c
+++ b/src/parse/properties/utils.c
@@ -1982,6 +1982,7 @@ css__parse_calc_product(css_language *c,
 					ctx, result);
 		} else {
 			error = css__parse_calc_number(vector, ctx, result);
+			consumeWhitespace(vector, ctx);
 		}
 		if (error != CSS_OK)
 			break;
