From 625edc4a2b35d620feedbf5fdc887a7fe5f41277 Mon Sep 17 00:00:00 2001
From: Michael Drake <tlsa@netsurf-browser.org>
Date: Sun, 15 Nov 2026 14:09:41 +0000
Subject: [PATCH] api: fpmath: Fix saturation in css_add_fixed and
 css_subtract_fixed

The old code was doing:

- FADD: `-10 +  1 = F_MAX`
- FSUB: `-10 - -1 = F_MAX`
---
 include/libcss/fpmath.h | 31 ++++++++++++-------------------
 1 file changed, 12 insertions(+), 19 deletions(-)

diff --git a/include/libcss/fpmath.h b/include/libcss/fpmath.h
index d2e60d5..9b6df9b 100644
--- a/include/libcss/fpmath.h
+++ b/include/libcss/fpmath.h
@@ -27,35 +27,28 @@ typedef int32_t css_fixed;
 
 static inline css_fixed
 css_add_fixed(const css_fixed x, const css_fixed y) {
-	int32_t ux = x;
-	int32_t uy = y;
-	int32_t res = ux + uy;
+	int64_t xx = (int64_t)x + (int64_t)y;
 
-	/* Calculate overflowed result. (Don't change the sign bit of ux) */
-	ux = (ux >> 31) + INT_MAX;
+	if (xx < F_MIN)
+		xx = F_MIN;
 
-	/* Force compiler to use cmovns instruction */
-	if ((int32_t) ((ux ^ uy) | ~(uy ^ res)) >= 0) {
-		res = ux;
-	}
+	if (xx > F_MAX)
+		xx = F_MAX;
 
-	return res;
+	return xx;
 }
 
 static inline css_fixed
 css_subtract_fixed(const css_fixed x, const css_fixed y) {
-	int32_t ux = x;
-	int32_t uy = y;
-	int32_t res = ux - uy;
+	int64_t xx = (int64_t)x - (int64_t)y;
 
-	ux = (ux >> 31) + INT_MAX;
+	if (xx < F_MIN)
+		xx = F_MIN;
 
-	/* Force compiler to use cmovns instruction */
-	if ((int32_t)((ux ^ uy) & (ux ^ res)) < 0) {
-		res = ux;
-	}
+	if (xx > F_MAX)
+		xx = F_MAX;
 
-	return res;
+	return xx;
 }
 
 static inline css_fixed
