# Opcoes do NetSurfX. A maior parte muda-se no menu Start > Definicoes
# (que grava o ficheiro data\Choices sozinho). Para as restantes: muda o
# nome deste ficheiro para "Choices" (sem extensao), tira o # das linhas
# que queres e ajusta os valores.
#
# Pagina inicial:
#homepage_url:file:///D:/res/home.html
#
# Margem para o overscan da TV, em pixeis de cada lado (0 = ecra inteiro):
#xbox_overscan_x:16
#xbox_overscan_y:12
#
# Tentar 720p (cabo componente e 720p activo no dashboard). 1 = sim
#xbox_hd:0
#
# Motor de pesquisa da barra de endereco (nome exacto): DuckDuckGo Lite, FrogFind, Google, Wikipedia
#search_web_provider:DuckDuckGo Lite
#
# Tamanho de letra base em decimos de ponto (128 = 12,8 pt) e minimo
#font_size:128
#font_min_size:100
#
# Bloquear publicidade (1) e carregar imagens (1)
#block_advertisements:1
#foreground_images:1
#background_images:1
#
# Memoria para paginas e imagens em cache (bytes)
#memory_cache_size:6291456
#
# Cache em disco (D:\cache), em bytes (0 = desligada) e dias a guardar
#disc_cache_size:67108864
#disc_cache_age:14
#
# Teclado USB com disposicao americana (1) em vez da portuguesa (0)
#xbox_kbd_us:0
#
# D-pad: 1 = saltar entre links, 0 = deslocar a pagina
#xbox_dpad_links:1
#
# Versao dos sites: 0 normal, 1 movel, 2 leve (telemovel antigo), 3 texto
#xbox_ua_mode:0
#
# Pasta dos downloads
#xbox_download_dir:E:\Downloads
